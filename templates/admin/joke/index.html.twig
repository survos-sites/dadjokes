{% extends 'admin/_layout.html.twig' %}

{% block title 'Jokes — Admin' %}

{% block admin_content %}
    <div class="toolbar">
        <span>{{ jokes|length }} joke(s)</span>
        <div class="actions">
            <a href="{{ path('admin_joke_print') }}" target="_blank" class="btn">🖨 Print (skips 1★)</a>
            <a href="{{ path('admin_joke_new') }}" class="btn btn-primary">+ New joke</a>
        </div>
    </div>

    <p class="hint">Grouped by age (little kids first — those also work on big kids, never the reverse). Click a star to rate. Use ↑/↓ to build your performance order within that age group — rating doesn't affect it.</p>

    <table>
        <thead>
            <tr>
                <th></th>
                <th>Keyword</th>
                <th>Joke</th>
                <th>Age</th>
                <th>Rating</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for joke in jokes %}
                <tr>
                    <td>
                        <div class="reorder">
                            <form class="inline" method="post" action="{{ path('admin_joke_move_up', {id: joke.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('move-joke-' ~ joke.id) }}">
                                <button type="submit" class="btn btn-move" title="Move up in set">&uarr;</button>
                            </form>
                            <form class="inline" method="post" action="{{ path('admin_joke_move_down', {id: joke.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('move-joke-' ~ joke.id) }}">
                                <button type="submit" class="btn btn-move" title="Move down in set">&darr;</button>
                            </form>
                        </div>
                    </td>
                    <td class="{{ joke.rating == 1 ? 'excluded' : '' }}">{{ joke.keyword }}</td>
                    <td class="{{ joke.rating == 1 ? 'excluded' : '' }}">{{ joke.joke }}</td>
                    <td><span class="badge {{ joke.ageGroup == 'little_kids' ? 'badge-little' : 'badge-big' }}">{{ joke.ageGroup == 'little_kids' ? 'little kids' : 'big kids' }}</span></td>
                    <td>
                        <div class="star-picker">
                            {% for n in 1..4 %}
                                <form class="inline" method="post" action="{{ path('admin_joke_rate', {id: joke.id, stars: n}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('rate-joke-' ~ joke.id) }}">
                                    <button type="submit" class="star-btn {{ n <= joke.rating ? 'star-on' : 'star-off' }}" title="Set {{ n }} star{{ n > 1 ? 's' : '' }}">★</button>
                                </form>
                            {% endfor %}
                        </div>
                    </td>
                    <td>
                        <div class="actions">
                            <a href="{{ path('admin_joke_edit', {id: joke.id}) }}" class="btn">Edit</a>
                            <form class="inline" method="post" action="{{ path('admin_joke_delete', {id: joke.id}) }}" onsubmit="return confirm('Delete &quot;{{ joke.keyword|e('js') }}&quot;?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-joke-' ~ joke.id) }}">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6">No jokes yet.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
