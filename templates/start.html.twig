{% extends "@SurvosFw/base.html.twig" %}

{% block title 'Dad Jokes' %}

{% block body %}
    {# One page for this trivial app, so it's rendered inline rather than
       fetched via F7's XHR router — see mobile_app_controller.js's `routes`
       value if a second page ever needs real client-side navigation. #}
    <div id="app" {{ stimulus_controller(survos_stimulus('mobile-bundle', 'app'), {
        name: 'DadJokes',
        configCode: 'dadjokes',
        config: fwConfig,
        locale: app.request.locale,
    }) }}>
        <div class="view view-main view-init safe-areas">
            {{ include('pages/review.html.twig') }}
        </div>

        {% include '@SurvosMobile/tabbar.html.twig' %}
    </div>
{% endblock %}
