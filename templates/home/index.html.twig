<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Dad Jokes</title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1/dist/css/tabler.min.css">
        <style>
            body { overflow-x: hidden; }

            /* Phone mockup -- same pattern as pgsc's landing.html.twig and rutado's
               home/index.html.twig: a pure-CSS frame around an iframe of the real, live app. */
            .phone-mock {
                width: 375px;
                max-width: 100%;
                aspect-ratio: 9 / 19;
                border: 14px solid #2f2f2f;
                border-radius: 34px;
                overflow: hidden;
                box-shadow: 0 12px 30px rgba(0, 0, 0, .25);
                background: #000;
                margin: 0 auto;
            }
            .phone-mock iframe {
                width: 100%;
                height: 100%;
                border: 0;
            }
            @media (min-width: 992px) {
                .phone-sticky { position: sticky; top: 2rem; }
            }
        </style>
    </head>
    <body>
        <div class="page">
            <div class="container-xl py-5">
                <div class="row justify-content-between align-items-start g-5">
                    <div class="col-lg-6 order-2 order-lg-1">
                        <h1 class="mb-3">Dad Jokes</h1>
                        <p class="lead text-secondary">
                            A flashcard app for memorizing dad jokes. Review, study, and never
                            leave a groan-worthy pun unfired again.
                        </p>

                        <a href="{{ appUrl }}" class="btn btn-primary">Open the app</a>
                        <a href="{{ path('admin_joke_index') }}" class="btn btn-link">
                            Manage jokes (admin)
                        </a>
                    </div>

                    <div class="col-lg-5 order-1 order-lg-2 phone-sticky">
                        <div class="phone-mock">
                            <iframe src="{{ appUrl }}" loading="lazy" title="Dad Jokes app"></iframe>
                        </div>
                        <p class="text-center text-secondary small mt-2">
                            Live app, not a screenshot — try it right here.
                        </p>
                        <figure class="text-center mt-3">
                            <a href="{{ appUrl }}">
                                <img src="{{ qr_code_url(appUrl) }}" alt="QR code to open Dad Jokes on your phone" style="max-width: 150px">
                            </a>
                            <figcaption class="text-secondary small mt-1">
                                Scan to open on your phone
                            </figcaption>
                        </figure>
                    </div>
                </div>
            </div>
        </div>
    </body>
</html>
