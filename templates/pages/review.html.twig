{% extends '_shell.html.twig' %}

{% block page %}
{#
    The controller sits directly on `.page` because F7's page:init/
    page:afterin DOM events are dispatched (and bubble from) the `.page`
    element itself — a listener on a descendant would never see them.
#}
<div class="page" data-name="review" {{ stimulus_controller('review') }}>
    <div class="navbar">
        <div class="navbar-bg"></div>
        <div class="navbar-inner sliding">
            <div class="title">Review</div>
            <div class="right" {{ stimulus_target('review', 'due') }} style="padding-right: 12px; font-weight: 600;"></div>
        </div>
    </div>

    <div class="page-content">
        <div class="review-meta" {{ stimulus_target('review', 'remaining') }}></div>

        <div class="review-toolbar">
            <button type="button" class="button button-small" {{ stimulus_target('review', 'learnToggle') }} {{ stimulus_action('review', 'toggleLearnMode', 'click') }}>Learn: Off</button>
            <button type="button" class="button button-small" {{ stimulus_action('review', 'speakCurrent', 'click') }}>🔊 Speak</button>
            <button type="button" class="button button-small" {{ stimulus_target('review', 'playToggle') }} {{ stimulus_action('review', 'toggleAutoPlay', 'click') }}>▶ Play all</button>
        </div>

        <div class="flip-card-stage">
            <div class="flip-card" {{ stimulus_target('review', 'card') }} {{ stimulus_action('review', 'flip', 'click') }}>
                <div class="flip-card-inner">
                    <div class="flip-card-face flip-card-front" {{ stimulus_target('review', 'front') }}></div>
                    <div class="flip-card-face flip-card-back" {{ stimulus_target('review', 'back') }}></div>
                </div>
            </div>
        </div>

        <div class="keyboard-hint">↑ Good &nbsp; ↓ Again &nbsp; ← → Browse all</div>

        {# FSRS ratings: Again=1, Hard=2, Good=3, Easy=4 — see assets/lib/fsrs.js #}
        <div class="grade-buttons">
            <button type="button" class="button button-fill color-red"
                    {{ stimulus_action('review', 'grade', 'click', {rating: 1}) }}>Again</button>
            <button type="button" class="button button-fill color-orange"
                    {{ stimulus_action('review', 'grade', 'click', {rating: 2}) }}>Hard</button>
            <button type="button" class="button button-fill color-blue"
                    {{ stimulus_action('review', 'grade', 'click', {rating: 3}) }}>Good</button>
            <button type="button" class="button button-fill color-green"
                    {{ stimulus_action('review', 'grade', 'click', {rating: 4}) }}>Easy</button>
        </div>
    </div>
</div>
{% endblock %}
